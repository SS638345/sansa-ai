{
  "name": "SANSA AI",
  "short_name": "SANSA AI",
  "description": "Free Tamil and English AI voice tools: speech to text, text to speech and more. Share a WhatsApp voice note to SANSA AI to get the text.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#06060a",
  "theme_color": "#06060a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            ".opus",
            ".ogg",
            ".oga",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".amr",
            ".3gp",
            ".mp4",
            ".webm"
          ]
        }
      ]
    }
  }
}
