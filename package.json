{
  "name": "sansa-voice-to-text",
  "version": "0.1.0",
  "private": true,
  "description": "Simple voice to text converter (Tamil + English): live mic dictation, recording and audio file upload.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.3.2",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "openai": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
