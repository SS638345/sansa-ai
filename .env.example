# Optional. Without a key, live mic dictation (free, in the browser) still works.
# With a key, "Record & convert" and "Upload audio file" are enabled.
OPENAI_API_KEY=
# Optional: use a compatible proxy / gateway
# OPENAI_BASE_URL=
# Optional: transcription model (default gpt-4o-mini-transcribe)
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
PORT=3001
